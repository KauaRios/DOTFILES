{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/assets/jpg.png",
    "type": "auto",
    "padding": {
      "top": 0,
      "left": 1
    },
    "width": 22,
    "height": 16
  },

  "display": {
    "separator": " "
  },

  "modules": [
    "break",

    {
      "type": "custom",
      "format": "\u001b[38;5;31m ╔\u001b[38;5;45m✦\u001b[0m \u001b[1;38;5;51mRIMURU · 転生スライム\u001b[0m \u001b[38;5;45m✦\u001b[38;5;31m╗\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;31m ╚\u001b[38;5;38m══════════════════\u001b[38;5;31m╝\u001b[0m"
    },

    "break",

    {
      "type": "custom",
      "format": "\u001b[38;5;31m ┌\u001b[38;5;45m✦\u001b[0m \u001b[1;38;5;51mSYSTEM\u001b[0m \u001b[38;5;31m──────┐\u001b[0m"
    },
    {
      "type": "user",
      "key": "\u001b[38;5;31m │\u001b[0m \u001b[38;5;45m\u001b[0m user  "
    },
    {
      "type": "os",
      "key": "\u001b[38;5;31m │\u001b[0m \u001b[38;5;38m󰣇\u001b[0m os    "
    },
    {
      "type": "kernel",
      "key": "\u001b[38;5;31m │\u001b[0m \u001b[38;5;45m\u001b[0m kern  "
    },
    {
      "type": "uptime",
      "key": "\u001b[38;5;31m │\u001b[0m \u001b[38;5;51m\u001b[0m up    "
    },
    {
      "type": "wm",
      "key": "\u001b[38;5;31m │\u001b[0m \u001b[38;5;38m\u001b[0m wm    "
    },
    {
      "type": "shell",
      "key": "\u001b[38;5;31m │\u001b[0m \u001b[38;5;45m\u001b[0m shell "
    },
    {
      "type": "packages",
      "key": "\u001b[38;5;31m │\u001b[0m \u001b[38;5;38m\u001b[0m pkgs  "
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;31m ├\u001b[38;5;45m✦\u001b[0m \u001b[1;38;5;51mHARDWARE\u001b[0m \u001b[38;5;31m────┤\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;5;31m │\u001b[0m \u001b[38;5;51m\u001b[0m cpu   "
    },
    {
      "type": "gpu",
      "key": "\u001b[38;5;31m │\u001b[0m \u001b[38;5;45m󱤓\u001b[0m gpu   "
    },
    {
      "type": "memory",
      "key": "\u001b[38;5;31m │\u001b[0m \u001b[38;5;38m\u001b[0m ram   "
    },
    {
      "type": "disk",
      "key": "\u001b[38;5;31m │\u001b[0m \u001b[38;5;51m\u001b[0m disk  "
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;31m └──────────────────┘\u001b[0m"
    },

    "break",

    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 1
    },

    "break"
  ]
}
