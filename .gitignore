# ==========================================
# DOTFILES .gitignore
# ==========================================

# ── Lixo de Editores e Temporários ──
*~
*.swp
*.swo
*.tmp
.cache/

# ── Logs de Execução ──
*.log

# ── Arquivos de Sistema Operacional ──
.DS_Store
Thumbs.db

# ── Opcional: Ignorar histórico de bash local se acabar caindo aí ──
.bash_history
.zsh_history